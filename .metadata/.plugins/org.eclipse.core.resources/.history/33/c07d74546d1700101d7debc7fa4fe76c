<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostel Rental System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <header class="bg-primary text-white text-center p-3">
    <h1>#StayHub</h1>
    <marquee behavior="" direction="left"><b>Find your perfect stay, effortlessly!</b></marquee>
  </header>
  <div class="container my-4">
    <div class="input-group mb-4">
      <input type="text" id="searchInput" class="form-control" placeholder="Search hostel...">
      <button class="btn btn-primary" id="searchButton">Search</button>
    </div>
    <div class="row" id="hostelCards"></div>
  </div>
  <script src="script_hostel.js"></script>
  <footer class="bg-dark text-white text-center py-3">
    <p>© 2024 StayHub. All rights reserved.</p>
  </footer>
</body>
</html>
